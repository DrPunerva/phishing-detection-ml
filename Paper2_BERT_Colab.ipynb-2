 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Paper 2: DistilBERT baseline (run on Google Colab with a GPU)\n",
    "\n",
    "**Steps**\n",
    "1. Runtime \u2192 Change runtime type \u2192 **T4 GPU** \u2192 Save.\n",
    "2. Runtime \u2192 **Run all**.\n",
    "3. When asked, upload **`corpus_features.csv`** (from the Zenodo zip of Gutierrez et al., folder `data/`).\n",
    "4. Wait about 30-40 minutes. At the end the file **`results_paper2_bert.csv`** downloads automatically. Send it back.\n",
    "\n",
    "The splits, cleaning and length matching are identical to `llm_phishing_experiment.py` and `p2_second_dataset.py` (seed 42), so the BERT numbers can be put directly next to the TF-IDF numbers."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "!pip -q install -U datasets accelerate\n",
    "!git clone -q https://github.com/anguzz/human-vs-llm-phishing-analyzer greco || true"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os, re, time, inspect, numpy as np, pandas as pd, torch\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, confusion_matrix\n",
    "from datasets import Dataset\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, TrainingArguments, Trainer, set_seed\n",
    "SEED = 42; set_seed(SEED)\n",
    "import transformers; print('GPU:', torch.cuda.is_available(), '| transformers', transformers.__version__)\n",
    "if not os.path.exists('corpus_features.csv'):\n",
    "    from google.colab import files\n",
    "    files.upload()"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "_PATTERNS = [\n",
    "    (re.compile(r\"\\[[^\\]]{0,40}\\]\"), \" \"),\n",
    "    (re.compile(r\"https?://\\S+|www\\.\\S+\"), \" \"),\n",
    "    (re.compile(r\"\\S+@\\S+\"), \" \"),\n",
    "    (re.compile(r\"\\byour ?bank\\b|\\bx{2,}\\b\", re.I), \" \"),\n",
    "    (re.compile(r\"\\bmonkey\\b|\\bjose\\b|\\busaa\\b\", re.I), \" \"),\n",
    "    (re.compile(r\"\\d+\"), \" \"),\n",
    "    (re.compile(r\"\\s+\"), \" \"),\n",
    "]\n",
    "def clean_text(s):\n",
    "    s = str(s)\n",
    "    for p, rep in _PATTERNS:\n",
    "        s = p.sub(rep, s)\n",
    "    return s.strip().lower()\n",
    "\n",
    "def load_d1(path='corpus_features.csv'):\n",
    "    f = pd.read_csv(path)\n",
    "    f['y'] = (f['label_origin'] == 'llm').astype(int)\n",
    "    f['text'] = f['text'].fillna('').astype(str)\n",
    "    f['n_chars'] = f['text'].str.len(); f['n_words'] = f['text'].str.split().str.len()\n",
    "    return f\n",
    "\n",
    "def load_d2(folder='greco'):\n",
    "    hum = pd.read_csv(os.path.join(folder, 'dataset', 'human-generated', 'phishing.csv'))\n",
    "    hum = pd.DataFrame({'text': hum['body'].fillna('').astype(str), 'y': 0})\n",
    "    lines = open(os.path.join(folder, 'dataset', 'llm-generated', 'phishing.csv'), encoding='utf-8').read().splitlines()[1:]\n",
    "    llm = pd.DataFrame({'text': [l.rsplit(',', 1)[0] for l in lines if l.strip()], 'y': 1})\n",
    "    d = pd.concat([hum, llm], ignore_index=True)\n",
    "    d['text'] = d['text'].str.replace('\\xa0', ' ').str.strip()\n",
    "    d = d[d.text.str.len() > 0].drop_duplicates('text').reset_index(drop=True)\n",
    "    d['n_chars'] = d.text.str.len(); d['n_words'] = d.text.str.split().str.len()\n",
    "    return d\n",
    "\n",
    "def d1_e3(df):\n",
    "    clean = df.copy(); clean['text'] = clean['text'].map(clean_text)\n",
    "    lo, hi = df.loc[df.y == 1, 'n_chars'].min(), df.loc[df.y == 1, 'n_chars'].max()\n",
    "    hum = clean[(clean.y == 0) & (clean.n_chars.between(lo, hi))]\n",
    "    llm = clean[clean.y == 1].sample(n=len(hum), random_state=SEED)\n",
    "    return pd.concat([hum, llm])\n",
    "\n",
    "def d2_e3(df):\n",
    "    c = df.copy(); c['text'] = c.text.map(clean_text)\n",
    "    lo, hi = df.loc[df.y == 1, 'n_chars'].min(), df.loc[df.y == 1, 'n_chars'].max()\n",
    "    hum = c[(c.y == 0) & c.n_chars.between(lo, hi)]; llm = c[c.y == 1]\n",
    "    n = min(len(hum), len(llm))\n",
    "    return pd.concat([hum.sample(n=n, random_state=SEED), llm.sample(n=n, random_state=SEED)])\n",
    "\n",
    "def balanced(d):\n",
    "    n = d.y.value_counts().min()\n",
    "    return pd.concat([d[d.y == 0].sample(n=n, random_state=SEED), d[d.y == 1].sample(n=n, random_state=SEED)])\n",
    "\n",
    "def metrics(y, pred, s):\n",
    "    tn, fp, fn, tp = confusion_matrix(y, pred, labels=[0, 1]).ravel()\n",
    "    return {'Accuracy': accuracy_score(y, pred), 'Precision': precision_score(y, pred, zero_division=0),\n",
    "            'Recall': recall_score(y, pred), 'F1': f1_score(y, pred), 'FPR': fp / (fp + tn), 'FNR': fn / (fn + tp),\n",
    "            'ROC-AUC': roc_auc_score(y, s), 'TP': int(tp), 'FP': int(fp), 'TN': int(tn), 'FN': int(fn)}"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "MODEL = 'distilbert-base-uncased'\n",
    "tok = AutoTokenizer.from_pretrained(MODEL)\n",
    "\n",
    "def to_ds(df):\n",
    "    ds = Dataset.from_pandas(df[['text', 'y']].rename(columns={'y': 'label'}).reset_index(drop=True))\n",
    "    return ds.map(lambda b: tok(b['text'], truncation=True, max_length=256, padding='max_length'), batched=True)\n",
    "\n",
    "def run_bert(train_df, test_df, tag):\n",
    "    set_seed(SEED)\n",
    "    model = AutoModelForSequenceClassification.from_pretrained(MODEL, num_labels=2)\n",
    "    steps = int(np.ceil(len(train_df) / 16)) * 2\n",
    "    kw = dict(output_dir='out_' + tag, num_train_epochs=2, learning_rate=2e-5,\n",
    "              per_device_train_batch_size=16, per_device_eval_batch_size=64,\n",
    "              weight_decay=0.01, warmup_steps=int(0.1 * steps), fp16=torch.cuda.is_available(),\n",
    "              save_strategy='no', logging_steps=100, report_to='none', seed=SEED)\n",
    "    ok = inspect.signature(TrainingArguments.__init__).parameters\n",
    "    args = TrainingArguments(**{k: v for k, v in kw.items() if k in ok})\n",
    "    t0 = time.time()\n",
    "    tr = Trainer(model=model, args=args, train_dataset=to_ds(train_df)); tr.train()\n",
    "    logits = tr.predict(to_ds(test_df)).predictions\n",
    "    prob = torch.softmax(torch.tensor(logits), dim=1)[:, 1].numpy()\n",
    "    r = metrics(test_df.y.values, (prob >= 0.5).astype(int), prob)\n",
    "    r['Train time (s)'] = time.time() - t0\n",
    "    print(tag, {k: round(v, 4) for k, v in r.items() if isinstance(v, float)})\n",
    "    return r"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "rows = []\n",
    "d1 = load_d1(); d2 = load_d2()\n",
    "print('D1', d1.shape, 'D2', d2.shape)\n",
    "\n",
    "# D1-E1: same split as llm_phishing_experiment.py (stratified by source)\n",
    "tr, te = train_test_split(d1, test_size=0.2, stratify=d1['source'], random_state=SEED)\n",
    "rows.append({'Experiment': 'E1 in-distribution', 'Train': 'D1', 'Test': 'D1', 'Features': 'Raw text', 'Model': 'DistilBERT', **run_bert(tr, te, 'd1_e1')})\n",
    "\n",
    "# D1-E3: cleaned + length-matched\n",
    "sub = d1_e3(d1); tr3, te3 = train_test_split(sub, test_size=0.2, stratify=sub.y, random_state=SEED)\n",
    "rows.append({'Experiment': 'E3 artefact-reduced', 'Train': 'D1', 'Test': 'D1', 'Features': 'Cleaned text', 'Model': 'DistilBERT', **run_bert(tr3, te3, 'd1_e3')})\n",
    "\n",
    "# D2-E1 and D2-E3\n",
    "tr, te = train_test_split(d2, test_size=0.2, stratify=d2.y, random_state=SEED)\n",
    "rows.append({'Experiment': 'D2-E1 in-distribution', 'Train': 'D2', 'Test': 'D2', 'Features': 'Raw text', 'Model': 'DistilBERT', **run_bert(tr, te, 'd2_e1')})\n",
    "sub = d2_e3(d2); tr3, te3 = train_test_split(sub, test_size=0.2, stratify=sub.y, random_state=SEED)\n",
    "rows.append({'Experiment': 'D2-E3 artefact-reduced', 'Train': 'D2', 'Test': 'D2', 'Features': 'Cleaned text', 'Model': 'DistilBERT', **run_bert(tr3, te3, 'd2_e3')})\n",
    "\n",
    "# X1 cross-dataset on cleaned text\n",
    "d1c = d1[['text', 'y']].copy(); d1c['text'] = d1c.text.map(clean_text)\n",
    "d2c = d2[['text', 'y']].copy(); d2c['text'] = d2c.text.map(clean_text)\n",
    "rows.append({'Experiment': 'X1 cross-dataset', 'Train': 'D1', 'Test': 'D2', 'Features': 'Cleaned text', 'Model': 'DistilBERT', **run_bert(d1c, balanced(d2c), 'x_d1_d2')})\n",
    "rows.append({'Experiment': 'X1 cross-dataset', 'Train': 'D2', 'Test': 'D1', 'Features': 'Cleaned text', 'Model': 'DistilBERT', **run_bert(d2c, balanced(d1c), 'x_d2_d1')})\n",
    "\n",
    "res = pd.DataFrame(rows); res.to_csv('results_paper2_bert.csv', index=False)\n",
    "print(res[['Experiment', 'Train', 'Test', 'Accuracy', 'F1', 'FPR', 'FNR', 'ROC-AUC']].round(4))"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "files.download('results_paper2_bert.csv')"
   ]
  }
 ]
}